---
import type { expertise } from '../data/demoContent';
interface Props { item: (typeof expertise)[number]; }
const { item } = Astro.props;
---
<article class="expertise-card">
  <div class="card-top"><span class="track-mark" aria-hidden="true">{item.mark === 'ops' ? '◎' : item.mark === 'data' ? '▥' : '⌘'}</span><span class="mono muted">{item.number}</span></div>
  <h3>{item.title}<span>{item.subtitle}</span></h3>
  <p>{item.description}</p>
  <ul class="tags" aria-label="Chủ đề định hướng">{item.skills.map(skill => <li>{skill}</li>)}</ul>
</article>
