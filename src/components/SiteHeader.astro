---
import { navigation, profile } from '../data/demoContent';
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href="/#home" aria-label={`${profile.name} — đầu trang`}><span class="monogram" aria-hidden="true">hd<span>.</span></span><span>{profile.name}</span></a>
    <nav class="desktop-nav" aria-label="Điều hướng chính">
      {navigation.map(item => <a href={item.href}>{item.label}</a>)}
      <a class="nav-contact" href="/#contact">Kết nối <span aria-hidden="true">↗</span></a>
    </nav>
    <details class="mobile-menu">
      <summary>Menu <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Điều hướng mobile">{navigation.map(item => <a href={item.href}>{item.label}</a>)}<a href="/#contact">Kết nối ↗</a></nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
    menu.open = false;
    const target = link.pathname === location.pathname && link.hash
      ? document.getElementById(decodeURIComponent(link.hash.slice(1))) : null;
    target?.focus({ preventScroll: true });
  }));
  menu?.addEventListener('keydown', event => {
    if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
</script>
