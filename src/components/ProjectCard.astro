---
import { projectHref, trackLabels, statusLabels, type Project } from '../data/demoContent';
interface Props { project: Project; }
const { project } = Astro.props;
---
<article class="project-card">
  <div class:list={['project-visual', project.visual]} aria-hidden="true">
    <span class="visual-label">CONCEPT STUDY / {project.number}</span>
    {project.visual === 'data' ? <div class="data-art"><div class="chart-grid"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span>QUESTION → INSIGHT</span></div> : <div class="ai-art"><span>CONTEXT</span><strong>ops<span>+</span></strong><span>ACTION</span></div>}
    <span class="visual-bottom">ILLUSTRATIVE / KHÔNG PHẢI KẾT QUẢ THỰC TẾ</span>
  </div>
  <div class="project-copy"><div class="project-meta"><span class="eyebrow">{project.careerTracks.map(track => trackLabels[track]).join(' · ')}</span>{project.demo && <span class="demo-badge">DEMO</span>}</div><h3><a href={projectHref(project)}>{project.title}<span class="sr-only"> — xem case study demo</span></a></h3><p>{project.description}</p><ul class="tags">{project.tags.map(tag => <li>{tag}</li>)}</ul><div class="project-status"><span class="status-dot"></span>{statusLabels[project.status]}</div><a class="text-link project-link" href={projectHref(project)} aria-label={`Đọc case study: ${project.title}`}>Đọc case study <span aria-hidden="true">↗</span></a></div>
</article>
