---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Homepage prototype của Hồ Văn Dinh — Management, Data và AI & Software Engineering." />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main">Bỏ qua điều hướng</a><slot /></body>
</html>
